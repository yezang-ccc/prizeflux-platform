# PrizeFlux 本地开发配置模板
#
# 使用方法：复制为 .env 后填写本机真实值。
# .env 已被 Git 忽略；本模板只能保留空值或安全示例，禁止填写真实密码和 Token。

# Spring 运行环境。后端骨架建立后使用 local-full 启动本地完整学习环境。
SPRING_PROFILES_ACTIVE=local-full

# MySQL
MYSQL_DATABASE=prizeflux
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=prizeflux_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# AI 服务。留空时必须使用本地 Fake Model，不能阻塞核心抽奖流程。
AI_PROVIDER=fake
AI_API_KEY=

# 说明：生产环境不会直接使用本文件保存密钥，而是在部署阶段通过受保护的密钥机制注入。
