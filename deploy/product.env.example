# Local-only container stack. Generate deploy/.env.product with new-product-env.ps1.
# Every secret is replaced locally with a fresh 64-character lowercase hex value.
PFX_CONTAINER_MYSQL_ROOT_PASSWORD=__GENERATE_64_HEX__
PFX_CAMPAIGN_RUNTIME_PASSWORD=__GENERATE_64_HEX__
PFX_CAMPAIGN_MIGRATION_PASSWORD=__GENERATE_64_HEX__
PFX_WORKER_RUNTIME_PASSWORD=__GENERATE_64_HEX__
PFX_WORKER_MIGRATION_PASSWORD=__GENERATE_64_HEX__
PFX_AGENT_RUNTIME_PASSWORD=__GENERATE_64_HEX__
PFX_AGENT_MIGRATION_PASSWORD=__GENERATE_64_HEX__
PFX_PRODUCT_JWT_SECRET=__GENERATE_64_HEX__
PFX_PRODUCT_WEB_PORT=8080

# Agent model connector: Fake is free/offline. Only switch after selecting a
# provider and confirming its billing. Keep real keys in ignored .env.product.
PFX_AGENT_MODEL_PROVIDER=fake
PFX_AGENT_MODEL_BASE_URL=
PFX_AGENT_MODEL_NAME=
PFX_AGENT_MODEL_API_KEY=

# Optional knowledge overlay: enable retrieval only after a verified active index.
PFX_AGENT_KNOWLEDGE_RETRIEVAL_ENABLED=false
