# Copy to deploy/.env and replace both values before starting Compose.
# This file configures only the local MySQL/Redis foundation. It is not a
# complete application-stack configuration; see the P14 deployment spec.
PFX_DB_ROOT_PASSWORD=replace-with-local-root-password
PFX_DB_PASSWORD=replace-with-local-app-password
PFX_DB_USER=prizeflux
# 3306 may belong to another local MySQL. The application JDBC URL below must
# use the same host port as this Compose mapping.
PFX_DB_PORT=3307
PFX_DB_URL=jdbc:mysql://127.0.0.1:3307/prizeflux
PFX_REDIS_PORT=6379

# JWT 签名密钥：至少 32 字节的随机串，仅存在于受保护运行环境。
# 缺失或过短时服务拒绝启动；仓库不提供任何可用默认密钥，请勿提交真实值。
PFX_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# 仅首次受控创建运营账号时设置下面变量，并临时启用
# PRIZEFLUX_BOOTSTRAP_OPERATOR_ENABLED=true；成功后立即移除。
# PFX_BOOTSTRAP_OPERATOR_USERNAME=operator
# PFX_BOOTSTRAP_OPERATOR_PASSWORD=replace-with-a-unique-long-password

# 独立进程冒烟/手动抽奖所需演示 USER 账号（幂等，已存在则跳过），同样临时启用。
# PRIZEFLUX_BOOTSTRAP_DEMO_USER_ENABLED=true
# PFX_BOOTSTRAP_DEMO_USERNAME=demo-user
# PFX_BOOTSTRAP_DEMO_PASSWORD=replace-with-a-unique-long-password
