FROM node:22.19.0-alpine3.22 AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.29.4-alpine3.23 AS proxy
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-build /web/dist /usr/share/nginx/html
RUN mkdir -p /tmp/nginx/client_temp /tmp/nginx/proxy_temp \
    && chown -R nginx:nginx /tmp/nginx
RUN nginx -t && chown -R nginx:nginx /tmp/nginx

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health/proxy || exit 1

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
