# Local process-stack contract only. Copy individual values into the shell or
# your ignored deploy/.env.local-full; never put real credentials in this file.
# This file is a template, not a working credential set.

# Campaign application account: DML only on prizeflux.
PFX_DB_URL=jdbc:mysql://127.0.0.1:3307/prizeflux
PFX_DB_USER=pfx_campaign_runtime
PFX_DB_PASSWORD=replace-with-campaign-runtime-password
# Campaign schema DDL account, used by Flyway at Campaign startup.
PFX_CAMPAIGN_MIGRATION_DB_URL=jdbc:mysql://127.0.0.1:3307/prizeflux
PFX_CAMPAIGN_MIGRATION_DB_USER=pfx_campaign_migrator
PFX_CAMPAIGN_MIGRATION_DB_PASSWORD=replace-with-campaign-migration-password

# Worker has a separate schema/account pair and Flyway identity.
PFX_WORKER_DB_URL=jdbc:mysql://127.0.0.1:3307/prizeflux_worker
PFX_WORKER_DB_USER=pfx_worker_runtime
PFX_WORKER_DB_PASSWORD=replace-with-worker-runtime-password
PFX_WORKER_MIGRATION_DB_URL=jdbc:mysql://127.0.0.1:3307/prizeflux_worker
PFX_WORKER_MIGRATION_DB_USER=pfx_worker_migrator
PFX_WORKER_MIGRATION_DB_PASSWORD=replace-with-worker-migration-password

# Python Agent has a separate schema and uses Alembic explicitly before startup.
PFX_AGENT_DATABASE_URL=mysql+asyncmy://pfx_agent_runtime:replace-with-agent-runtime-password@127.0.0.1:3307/prizeflux_agent
PFX_AGENT_MIGRATION_DATABASE_URL=mysql+asyncmy://pfx_agent_migrator:replace-with-agent-migration-password@127.0.0.1:3307/prizeflux_agent

# Process endpoints. Kafka is a separately managed local dependency.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
PFX_AGENT_CAMPAIGN_BASE_URL=http://127.0.0.1:8081
PFX_JWT_SECRET=replace-with-random-secret-at-least-32-bytes
PFX_AGENT_MODEL_PROVIDER=fake
PFX_AGENT_MODEL_BASE_URL=
PFX_AGENT_MODEL_NAME=
PFX_AGENT_MODEL_API_KEY=
PFX_AGENT_KNOWLEDGE_RETRIEVAL_ENABLED=false
PFX_AGENT_MAX_CONCURRENT_RUNS=4
PFX_AGENT_MAX_WAITING_RUNS=16
PFX_AGENT_MAX_RUNS_PER_OWNER=4
