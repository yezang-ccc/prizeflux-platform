<?xml version="1.0" encoding="UTF-8"?>
<!--
  PrizeFlux 后端的唯一构建入口。

  这里不承载任何业务代码，而是统一约束五个后端模块使用同一套 Java 和框架版本。
  子模块以后只声明“需要什么依赖”，版本由此处统一决定，避免产生彼此不兼容的版本组合。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot Parent 提供经过验证的插件和常用依赖版本管理。
      relativePath 为空表示只从 Maven 仓库解析，不会意外依赖本地同名 POM。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.prizeflux</groupId>
    <artifactId>prizeflux-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PrizeFlux Backend</name>
    <description>PrizeFlux 的多模块后端构建根工程</description>

    <properties>
        <!-- 所有模块使用 Java 17，后续升级必须单独验证和提交。 -->
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Spring Cloud 通过 BOM 管理，具体依赖暂不在本任务中引入。 -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>

        <!-- 3.0.5 以 Spring Boot 3.5 为基线；4.x 仅适配 Spring Boot 4。 -->
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
    </properties>

    <!--
      dependencyManagement 只管理版本，不会自动把依赖带进任何子模块。
      例如 Gateway 模块以后声明 spring-cloud-starter-gateway 时不写 version，
      Maven 会在这里找到与 Spring Boot 兼容的版本。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- MyBatis Starter 不在 Spring Boot BOM 中，在根工程统一约束版本。 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      先写出完整模块地图；D1-02B 会创建这五个目录和对应 POM。
      在它们创建完成前，不运行会解析 Reactor 的 validate/package 命令。
    -->
    <modules>
        <module>prizeflux-contract</module>
        <module>prizeflux-gateway</module>
        <module>prizeflux-campaign</module>
        <module>prizeflux-worker</module>
        <module>prizeflux-ai</module>
    </modules>
</project>
