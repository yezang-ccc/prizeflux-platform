<?xml version="1.0" encoding="UTF-8"?>
<!--
  核心业务模块。
  后续承载活动、抽奖、库存、中奖记录和事务边界；
  本任务只建立其 Maven 身份，不创建 Controller、Service、Mapper 或数据库表。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.prizeflux</groupId>
        <artifactId>prizeflux-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>prizeflux-campaign</artifactId>
    <packaging>jar</packaging>
    <name>PrizeFlux Campaign</name>

    <!--
      dependencies 表示“本模块真正需要使用的库”。
      它们的版本故意不写在这里：本模块通过 parent 继承根 POM，
      根 POM 又继承 Spring Boot Parent，因此由上层统一提供兼容版本。
      这正是 D1-02 学到的“依赖管理规则”和“实际引入依赖”的区别。
    -->
    <dependencies>
        <!-- 复用 D2-01 的纯 Java 响应/错误契约；Campaign 依赖 Contract，不反向依赖。 -->
        <dependency>
            <groupId>com.prizeflux</groupId>
            <artifactId>prizeflux-contract</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 提供 Jakarta Bean Validation；版本继承 Spring Boot Parent 的管理规则。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          为 Campaign 提供 Spring MVC、内嵌 Web 服务器和 JSON 序列化。
          D1-03 的 HealthController 会使用其中的 @RestController、@GetMapping 等能力。
          现在只建立 HTTP 入口，不因此引入数据库、Redis、消息队列或业务实现。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Opt-in local-full operational metrics; no external Prometheus process is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 只使用 Spring Security 的 BCrypt 密码编码；完整过滤链在 I4/I5 接入。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          I3 只引入 JWT 签发/校验（Nimbus JOSE），不引入 spring-security-web/config，
          避免默认安全过滤链在本阶段改变既有 HTTP 行为；
          完整资源服务器过滤链与授权规则在 I4/I5 接入并同步回归旧接口。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!--
          I4 接入资源服务器过滤链：登录签发令牌、/me 读取安全上下文、ActorProvider 从上下文取身份。
          该 starter 传递引入 spring-security-web/config 与 resource-server，版本由 Boot Parent 管理；
          我方法自行提供 SecurityFilterChain，避免默认"全部需认证"过滤链覆盖健康接口。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Repository 的基础设施实现使用 MyBatis；版本由根 POM 统一管理。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- Flyway 维护可追踪的数据库迁移；MySQL 支持从 Flyway 10 起独立成模块。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MySQL 驱动只在实际运行时需要，不作为领域代码的编译依赖。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          D7-03 引入 Kafka 客户端：Outbox Relay 通过它把发奖事件投递到下游 Worker。
          版本由 Spring Boot Parent 统一管理（spring-kafka 3.3.x 适配 Boot 3.5）。
          这里只引入客户端库；Producer 的构造与启停在 KafkaProducerConfiguration 中按
          prizeflux.kafka.enabled 门控，未启用时不会建立任何连接。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redis 只用于可选的流量治理；业务库存和幂等仍由 MySQL 负责。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          仅供测试代码使用。它提供 JUnit、Spring Test 和 MockMvc，
          用于从 HTTP 请求角度验证健康接口，而不是只直接调用 Java 方法。
          scope=test 意味着它不会进入应用实际运行时的部署包。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试通过 Docker 启动一次性真实 MySQL；不进入生产包。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              让 Maven 能以 Spring Boot 应用的方式运行和打包本模块。
              插件版本同样由 Spring Boot Parent 统一管理，避免子模块自行锁定不兼容版本。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
