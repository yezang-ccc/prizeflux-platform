# Local/offline fallback: build the JAR with backend/mvnw.cmd first, then use
# the module's target directory as Docker build context. Never use this as a
# substitute for compiling or testing the current source.
FROM eclipse-temurin:17.0.20.1_1-jre-jammy
ARG MODULE
WORKDIR /app
COPY --chown=10001:10001 ${MODULE}-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001:10001
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/app.jar"]
